{
  "name": "mason-context",
  "version": "0.7.0",
  "description": "MCP server for codebase context engineering — feature-to-file concept maps, change impact, and Confluence wiki sync for AI coding assistants",
  "type": "module",
  "mcpName": "com.adrianczuczka/mason",
  "bin": {
    "mason": "dist/mason.js",
    "mason-mcp": "dist/mason-mcp.js",
    "mason-context": "dist/mason-mcp.js",
    "mason-drift": "dist/mason-drift.js",
    "mason-audit": "dist/mason-audit.js",
    "mason-hook": "dist/mason-hook.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:mcpb": "node scripts/pack-mcpb.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "claude-code",
    "cursor",
    "windsurf",
    "context-engineering",
    "code-analysis",
    "concept-map",
    "snapshot",
    "confluence",
    "ai"
  ],
  "author": "Adrian Czuczka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianczuczka/mason.git"
  },
  "homepage": "https://github.com/adrianczuczka/mason",
  "bugs": {
    "url": "https://github.com/adrianczuczka/mason/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-glob": "^3.3.3",
    "openai": "^6.33.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  }
}
