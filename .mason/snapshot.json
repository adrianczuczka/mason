  "flows": {
    "drift check flow": {
      "description": "CI entry point runs the deterministic drift check against git HEAD",
      "chain": [
        "bin/mason-drift.ts",
        "src/drift/cli.ts",
        "src/drift/drift.ts"
      ]
    },
    "decision staleness flow": {
      "description": "Flags active decisions whose anchor files changed since last verified",
      "chain": [
        "src/decisions/drift.ts",
        "src/drift/drift.ts",
        "src/decisions/decisions.ts"
      ]
    },
    "MCP server startup flow": {
      "description": "Binary boots the MCP stdio server which registers all tool implementations",
      "chain": [
        "bin/mason-mcp.ts",
        "src/mcp/server.ts",
        "src/mcp/tools.ts"
      ]
    },
    "Confluence sync flow": {
      "description": "Loads the snapshot, diffs against sync state, and pushes rendered pages to Confluence",
      "chain": [
        "src/confluence/sync.ts",
        "src/confluence/diff.ts",
        "src/confluence/renderer.ts",
        "src/confluence/client.ts"
      ]
    },
    "get_context assembly flow": {
      "description": "Scores the task description against the snapshot and enriches with drift, impact, and decisions",
      "chain": [
        "src/context/assemble.ts",
        "src/context/lexical.ts",
        "src/snapshot/snapshot.ts",
        "src/drift/drift.ts",
        "src/impact/impact.ts",
        "src/decisions/decisions.ts"
      ]
    }
  }
